---
/**
 * Hero — a dispatcher, not a component.
 *
 * Picks the hero variant for the active theme. Stays at this path so
 * `src/pages/index.astro` never changes.
 *
 * The rotator's client script lives HERE rather than in each variant: Astro
 * hoists a component's `<script>` into the page bundle from the static module
 * graph, so five variants with five copies would ship five scripts to every
 * visitor. One script that no-ops when `#hero-role` is absent costs nothing on
 * the themes that don't animate a headline (editorial, swiss, broadcast).
 */
import { getThemeLayout } from '@/config';
import HeroTerminal from '@components/themed/hero/HeroTerminal.astro';
import HeroDataGrid from '@components/themed/hero/HeroDataGrid.astro';
import HeroEditorial from '@components/themed/hero/HeroEditorial.astro';
import HeroSwiss from '@components/themed/hero/HeroSwiss.astro';
import HeroBroadcast from '@components/themed/hero/HeroBroadcast.astro';

const layout = getThemeLayout(Astro.locals?.theme);
---

{layout.hero === 'terminal' && <HeroTerminal />}
{layout.hero === 'datagrid' && <HeroDataGrid />}
{layout.hero === 'editorial' && <HeroEditorial />}
{layout.hero === 'swiss' && <HeroSwiss />}
{layout.hero === 'broadcast' && <HeroBroadcast />}

<script>
  import { scrambleText } from '@lib/utils/scramble';
  import { HERO } from '@/config';

  /** Cycles the role word with a decrypt effect. No-ops on hero variants that
   *  don't render `#hero-role` — an editorial or poster hero shouldn't flicker. */
  function initHeroRotator() {
    const el = document.getElementById('hero-role');
    if (!el || el.dataset.bound) return;
    el.dataset.bound = 'true';

    const words = HERO.rotatorWords;
    let i = 0;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Timed just after the h1's own scroll-reveal fade so the two don't compete.
    window.setTimeout(() => scrambleText(el, words[0], { duration: 1 }), 350);

    setInterval(() => {
      i = (i + 1) % words.length;
      scrambleText(el, words[i], { duration: 0.6 });
    }, 3200);
  }

  /** Retire the lanyard skeleton once the 3D canvas exists (cyberpunk only). */
  function initLanyardSkeleton() {
    const slot = document.querySelector<HTMLElement>('[data-lanyard-slot]');
    const skeleton = slot?.querySelector<HTMLElement>('[data-lanyard-skeleton]');
    if (!slot || !skeleton || slot.dataset.skeletonBound) return;
    slot.dataset.skeletonBound = 'true';

    if (slot.querySelector('canvas')) {
      skeleton.remove();
      return;
    }
    const observer = new MutationObserver(() => {
      if (slot.querySelector('canvas')) {
        skeleton.remove();
        observer.disconnect();
      }
    });
    observer.observe(slot, { childList: true, subtree: true });
  }

  document.addEventListener('astro:page-load', () => {
    initHeroRotator();
    initLanyardSkeleton();
  });
</script>
