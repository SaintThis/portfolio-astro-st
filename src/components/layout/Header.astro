---
/**
 * Header — a dispatcher, not a component.
 *
 * Picks the nav variant for the active theme (resolved per request in
 * middleware). It stays at this path so every consumer — `BaseLayout` and
 * anything else that mounts a header — is untouched by the variant system.
 *
 * Variants are statically imported on purpose: `await import()` in frontmatter
 * would drop each variant's scoped CSS out of the page's static module graph,
 * so Astro would never emit its <link>. The set is kept deliberately small
 * (three files, one of which serves three themes via a class table) because
 * every imported variant's CSS ships on every page regardless of what renders.
 */
import { getThemeLayout } from '@/config';
import NavBar from '@components/themed/nav/NavBar.astro';
import NavMasthead from '@components/themed/nav/NavMasthead.astro';
import NavRail from '@components/themed/nav/NavRail.astro';

const layout = getThemeLayout(Astro.locals?.theme);
---

{layout.nav === 'masthead' && <NavMasthead />}
{layout.nav === 'rail' && <NavRail />}
{layout.nav === 'block' && <NavBar mode="block" />}
{layout.nav === 'bar' && <NavBar mode="bar" />}

<script>
  // The header persists across View Transitions, so its server-rendered active
  // state would go stale. Recompute it on every navigation.
  //
  // Deliberately toggles ONLY `aria-current` — appearance is CSS keyed off that
  // attribute (see `.nav-link[aria-current='page']` in global.css). The previous
  // version toggled hardcoded Tailwind classes, which meant any nav variant that
  // restyled its links silently lost its active state.
  function syncActiveNav() {
    const path = window.location.pathname;
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((link) => {
      const href = new URL(link.href).pathname;
      const active = href === '/' ? path === '/' : path.startsWith(href);
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  }

  document.addEventListener('astro:page-load', syncActiveNav);
</script>
