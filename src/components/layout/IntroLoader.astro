---
/**
 * Intro / boot loader — the GLOBAL, once-per-document loading state.
 *
 * Runs on a cold document only: first visit, a hard refresh, or a direct URL
 * hit. It deliberately does NOT run on client-side navigation — covering the
 * whole viewport on every link click made the site feel slower than it is, and
 * hid content that Astro had already fetched. Redirection gets a much lighter
 * treatment instead (see `NavProgress.astro`), and genuinely async content uses
 * `Skeleton.astro`.
 *
 * How "cold document" is detected: this module's own scope. View Transitions
 * swap the DOM but never re-evaluate persisted scripts, so `hasBooted` stays
 * true across navigations; a real reload re-evaluates the module and resets it.
 *
 * Implemented as an Astro component with a vanilla + GSAP client script rather
 * than a React island, because the swap lifecycle is far easier to hook
 * reliably from a persistent script than from a re-mounting island.
 *
 * Persisted across navigations via `transition:persist` so it never unmounts.
 */
import { SITE } from '@/config';
---

<div id="boot" class="boot" data-state="boot" transition:persist aria-hidden="true">
  <div class="boot__inner scanlines">
    <pre class="boot__log font-mono"><span data-line>▓ initializing kernel...</span>
<span data-line>▓ mounting /{SITE.handle}</span>
<span data-line>▓ syncing content collections...</span>
<span data-line>▓ decrypting theme buffers...</span>
<span data-line>▓ waking cursor daemon...</span>
<span data-line>▓ establishing secure uplink ✓</span></pre>
    <div class="boot__bar-row">
      <div class="boot__bar"><i></i></div>
      <span class="boot__pct font-mono" data-pct>0%</span>
    </div>
    <div class="boot__brand font-mono">
      <span class="text-gradient" data-brand>{SITE.name}</span><span class="boot__caret">_</span>
    </div>
  </div>
</div>

<style>
  .boot {
    position: fixed;
    inset: 0;
    z-index: 9998;
    display: grid;
    place-items: center;
    background: var(--color-bg);
    background-image:
      radial-gradient(60% 60% at 50% 40%, color-mix(in srgb, var(--color-accent) 8%, transparent), transparent);
  }
  .boot[data-state='done'] {
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
  }
  .boot__inner {
    position: relative;
    width: min(90vw, 520px);
    padding: 1.5rem;
  }
  .boot__log {
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--color-fg-muted);
    margin: 0 0 1rem;
  }
  .boot__log [data-line] {
    display: block;
    opacity: 0;
  }
  .boot__bar-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .boot__bar {
    height: 3px;
    flex: 1;
    background: var(--color-surface-2);
    border-radius: 2px;
    overflow: hidden;
  }
  .boot__bar > i {
    display: block;
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-2));
    box-shadow: var(--glow) var(--color-accent);
  }
  .boot__pct {
    font-size: 0.7rem;
    color: var(--color-fg-faint);
    min-width: 2.5em;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .boot__brand {
    margin-top: 1.25rem;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .boot__caret {
    animation: blink 1s step-end infinite;
    color: var(--color-accent-2);
  }
  @media (prefers-reduced-motion: reduce) {
    .boot { transition: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { scrambleText } from '@lib/utils/scramble';

  const MIN_BOOT = 1000; // ms — long enough to feel intentional, short enough not to annoy
  /** Module-scoped, so it survives View Transitions but resets on a real
   *  reload — which is exactly the "cold document" test we want. */
  let hasBooted = false;
  let failsafe = 0;

  function runBoot() {
    const boot = document.getElementById('boot');
    if (!boot) return;

    // Failsafe must NOT depend on GSAP: `hideBoot` animates via rAF, and rAF is
    // throttled (or stopped entirely) in a background tab — so a GSAP-based
    // failsafe could never fire in exactly the case it exists for, leaving the
    // overlay covering the page when the visitor returns. `forceHide` writes
    // styles directly instead.
    window.clearTimeout(failsafe);
    failsafe = window.setTimeout(forceHide, 2600);

    // Nothing to watch in a hidden tab — skip straight to the finished state so
    // the page is ready the moment it's foregrounded.
    if (document.visibilityState === 'hidden') {
      forceHide();
      return;
    }

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    boot.dataset.state = 'boot';
    boot.style.opacity = '1';
    boot.style.visibility = 'visible';

    const lines = boot.querySelectorAll('[data-line]');
    const bar = boot.querySelector<HTMLElement>('.boot__bar > i');
    const pct = boot.querySelector<HTMLElement>('[data-pct]');
    const brand = boot.querySelector<HTMLElement>('[data-brand]');
    const brandText = brand?.textContent ?? '';

    if (reduced) {
      gsap.set([...lines], { opacity: 1 });
      if (pct) pct.textContent = '100%';
      window.setTimeout(hideBoot, 180);
      return;
    }

    const tl = gsap.timeline({
      onComplete: () => {
        if (brand) {
          scrambleText(brand, brandText, { duration: 0.45, onComplete: () => window.setTimeout(hideBoot, 150) });
        } else {
          window.setTimeout(hideBoot, 120);
        }
      },
    });
    tl.to(
      bar,
      {
        width: '100%',
        duration: MIN_BOOT / 1000,
        ease: 'power2.out',
        onUpdate: function () {
          if (pct) pct.textContent = `${Math.round(this.progress() * 100)}%`;
        },
      },
      0
    );
    tl.to([...lines], { opacity: 1, stagger: MIN_BOOT / 1000 / lines.length, duration: 0.08 }, 0);
  }

  /** Hard, synchronous teardown — no animation, no rAF dependency. */
  function forceHide() {
    const boot = document.getElementById('boot');
    if (!boot || boot.dataset.state === 'done') return;
    window.clearTimeout(failsafe);
    gsap.killTweensOf(boot);
    boot.dataset.state = 'done';
    boot.style.opacity = '0';
    boot.style.display = 'none';
    document.dispatchEvent(new CustomEvent('boot:done'));
  }

  function hideBoot() {
    const boot = document.getElementById('boot');
    if (!boot || boot.dataset.state === 'done') return;
    window.clearTimeout(failsafe);
    gsap.to(boot, {
      opacity: 0,
      duration: 0.45,
      ease: 'power2.inOut',
      onComplete: () => {
        boot.dataset.state = 'done';
        boot.style.display = 'none';
        document.dispatchEvent(new CustomEvent('boot:done'));
      },
    });
    // Belt-and-braces: if the fade's rAF never completes (tab backgrounded
    // mid-fade), retire it anyway shortly after the animation's own duration.
    window.setTimeout(forceHide, 700);
  }

  /** Retire the overlay for the rest of this document's life. Called once the
   *  first boot finishes so a later navigation can never re-show it. */
  function retire() {
    const boot = document.getElementById('boot');
    if (!boot) return;
    window.clearTimeout(failsafe);
    boot.dataset.state = 'done';
    boot.style.display = 'none';
  }

  // Cold document only — see the component comment. Subsequent
  // `astro:page-load` events (client-side navigation) fall through to the
  // `retire()` branch, so the overlay never covers a redirect.
  document.addEventListener('astro:page-load', () => {
    if (hasBooted) {
      retire();
      return;
    }
    hasBooted = true;
    runBoot();
  });

  document.addEventListener('boot:done', retire, { once: true });
</script>
