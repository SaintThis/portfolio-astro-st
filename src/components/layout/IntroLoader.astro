---
/**
 * Intro / boot loader — the GLOBAL, once-per-document loading state.
 *
 * Runs on a cold document only: first visit, a hard refresh, or a direct URL
 * hit. It deliberately does NOT run on client-side navigation — covering the
 * whole viewport on every link click made the site feel slower than it is, and
 * hid content that Astro had already fetched. Redirection gets a much lighter
 * treatment instead (see `NavProgress.astro`), and genuinely async content uses
 * `Skeleton.astro`.
 *
 * How "cold document" is detected: this module's own scope. View Transitions
 * swap the DOM but never re-evaluate persisted scripts, so `hasBooted` stays
 * true across navigations; a real reload re-evaluates the module and resets it.
 *
 * Implemented as an Astro component with a vanilla + GSAP client script rather
 * than a React island, because the swap lifecycle is far easier to hook
 * reliably from a persistent script than from a re-mounting island.
 *
 * Persisted across navigations via `transition:persist` so it never unmounts.
 *
 * Per-theme personality is DATA, not five cloned overlays: the structure is
 * fixed and `LOADERS[theme]` supplies the log lines, whether the progress bar
 * appears, and a `motif` id. The motif is a small theme-specific visual (HUD
 * corner reticle for cyberpunk, falling glyph rain for matrix, a self-drawing
 * rule for latte, a ticking Swiss numeral for paper, broadcast color bars) —
 * still one component/one file (see `component-inventory.md`: resist forking
 * this into five), just with real per-theme identity instead of five themes
 * reusing an identical box with only the log text swapped.
 */
import { SITE, LOADERS, getThemeLayout, type LoaderId } from '@/config';

const layout = getThemeLayout(Astro.locals?.theme);
const loader = LOADERS[layout.loader as LoaderId] ?? LOADERS.boot;
const motif = loader.motif;
const kicker = 'kicker' in loader ? loader.kicker : undefined;
---

<div id="boot" class="boot" data-state="boot" data-motif={motif} transition:persist aria-hidden="true">
  {
    motif === 'rain' && (
      <div class="boot__rain" data-rain aria-hidden="true">
        {Array.from({ length: 16 }).map((_, i) => (
          <span class="boot__rain-col" style={`--i:${i}`} />
        ))}
      </div>
    )
  }

  <div class="boot__inner scanlines">
    {
      motif === 'hud' && (
        <div class="boot__hud" aria-hidden="true">
          <span class="boot__corner boot__corner--tl" />
          <span class="boot__corner boot__corner--tr" />
          <span class="boot__corner boot__corner--bl" />
          <span class="boot__corner boot__corner--br" />
          <span class="boot__scan" />
        </div>
      )
    }

    {
      motif === 'broadcast' && (
        <div class="boot__bars" aria-hidden="true">
          <span /><span /><span /><span /><span /><span />
        </div>
      )
    }

    {
      motif === 'index' && (
        <div class="boot__index" aria-hidden="true">
          <span class="boot__index-num font-mono" data-count>
            00
          </span>
          <span class="boot__index-rule" />
        </div>
      )
    }

    {kicker && <p class="boot__kicker font-serif">{kicker}</p>}

    {
      loader.lines.length > 0 && (
        <div class="boot__log font-mono">
          {loader.lines.map((l) => (
            <span data-line>{l}</span>
          ))}
        </div>
      )
    }
    {
      loader.showBar && (
        <div class="boot__bar-row">
          <div class="boot__bar">
            <i />
          </div>
          <span class="boot__pct font-mono" data-pct>
            0%
          </span>
        </div>
      )
    }
    <div class="boot__brand font-mono">
      {motif === 'broadcast' && <span class="boot__dot" aria-hidden="true" />}
      <span class="text-gradient" data-brand>{SITE.name}</span><span class="boot__caret">_</span>
    </div>
    {motif === 'masthead' && <span class="boot__rule" data-rule aria-hidden="true" />}
  </div>
</div>

<style>
  .boot {
    position: fixed;
    inset: 0;
    z-index: 9998;
    display: grid;
    place-items: center;
    background: var(--color-bg);
    background-image:
      radial-gradient(60% 60% at 50% 40%, color-mix(in srgb, var(--color-accent) 8%, transparent), transparent);
    overflow: hidden;
  }
  .boot[data-state='done'] {
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
  }
  .boot__inner {
    position: relative;
    width: min(90vw, 520px);
    padding: 1.5rem;
  }
  .boot__log {
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--color-fg-muted);
    margin: 0 0 1rem;
  }
  .boot__log [data-line] {
    display: block;
    opacity: 0;
  }
  .boot__bar-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .boot__bar {
    height: 3px;
    flex: 1;
    background: var(--color-surface-2);
    border-radius: 2px;
    overflow: hidden;
  }
  .boot__bar > i {
    display: block;
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-2));
    box-shadow: var(--glow) var(--color-accent);
  }
  .boot__pct {
    font-size: 0.7rem;
    color: var(--color-fg-faint);
    min-width: 2.5em;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .boot__brand {
    margin-top: 1.25rem;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .boot__caret {
    animation: blink 1s step-end infinite;
    color: var(--color-accent-2);
  }

  /* ---------------------------------------------------------------- */
  /* Motif: hud (cyberpunk) — HUD corner reticle + a scan-line sweep   */
  /* ---------------------------------------------------------------- */
  .boot__hud {
    position: absolute;
    inset: -1.25rem;
    pointer-events: none;
  }
  .boot__corner {
    position: absolute;
    width: 1.1rem;
    height: 1.1rem;
    border: 2px solid var(--color-accent);
    opacity: 0.75;
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--color-accent) 60%, transparent));
  }
  .boot__corner--tl { top: 0; left: 0; border-right: none; border-bottom: none; }
  .boot__corner--tr { top: 0; right: 0; border-left: none; border-bottom: none; }
  .boot__corner--bl { bottom: 0; left: 0; border-right: none; border-top: none; }
  .boot__corner--br { bottom: 0; right: 0; border-left: none; border-top: none; }
  .boot__scan {
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    height: 2px;
    top: 0;
    background: linear-gradient(90deg, transparent, var(--color-accent-2), transparent);
    box-shadow: 0 0 8px 1px var(--color-accent-2);
    animation: boot-scan 2.4s ease-in-out infinite;
  }
  @keyframes boot-scan {
    0%, 100% { top: 4%; opacity: 0; }
    10% { opacity: 1; }
    50% { top: 94%; opacity: 1; }
    60% { opacity: 0; }
  }

  /* ---------------------------------------------------------------- */
  /* Motif: rain (matrix) — falling glyph columns behind the panel    */
  /* ---------------------------------------------------------------- */
  .boot__rain {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: space-between;
    padding: 0 4%;
    opacity: 0.5;
  }
  .boot__rain-col {
    flex: 1;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.3;
    white-space: pre;
    text-align: center;
    color: var(--color-accent-2);
    text-shadow: 0 0 6px color-mix(in srgb, var(--color-accent-2) 70%, transparent);
    transform: translateY(-40%);
    animation: boot-rain 5.5s linear infinite;
    animation-delay: calc(var(--i) * -0.35s);
    opacity: 0;
  }
  @keyframes boot-rain {
    0% { transform: translateY(-45%); opacity: 0; }
    8% { opacity: 0.9; }
    85% { opacity: 0.9; }
    100% { transform: translateY(45%); opacity: 0; }
  }

  /* ---------------------------------------------------------------- */
  /* Motif: masthead (latte) — kicker + self-drawing rule              */
  /* ---------------------------------------------------------------- */
  .boot__kicker {
    margin: 0 0 0.35rem;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--color-fg-faint);
    letter-spacing: 0.03em;
  }
  .boot__rule {
    display: block;
    margin-top: 1rem;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent), transparent 85%);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  /* ---------------------------------------------------------------- */
  /* Motif: index (paper) — a large ticking Swiss-poster numeral       */
  /* ---------------------------------------------------------------- */
  .boot__index {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .boot__index-num {
    font-size: 3.25rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--color-fg);
  }
  .boot__index-rule {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  /* ---------------------------------------------------------------- */
  /* Motif: broadcast — TV test-pattern color bars + an ON-AIR dot     */
  /* ---------------------------------------------------------------- */
  .boot__bars {
    display: flex;
    gap: 2px;
    height: 0.5rem;
    margin-bottom: 1.25rem;
    border-radius: 1px;
    overflow: hidden;
  }
  .boot__bars > span {
    flex: 1;
    animation: boot-bars-flicker 1.8s ease-in-out infinite;
  }
  .boot__bars > span:nth-child(1) { background: var(--color-accent); animation-delay: 0s; }
  .boot__bars > span:nth-child(2) { background: var(--color-accent-2); animation-delay: 0.1s; }
  .boot__bars > span:nth-child(3) { background: var(--color-accent-3); animation-delay: 0.2s; }
  .boot__bars > span:nth-child(4) { background: var(--color-warning); animation-delay: 0.3s; }
  .boot__bars > span:nth-child(5) { background: var(--color-fg); animation-delay: 0.4s; }
  .boot__bars > span:nth-child(6) { background: var(--color-fg-muted); animation-delay: 0.5s; }
  @keyframes boot-bars-flicker {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.55; }
  }
  .boot__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-danger);
    box-shadow: 0 0 6px var(--color-danger);
    animation: boot-dot-blink 1.1s step-end infinite;
  }
  @keyframes boot-dot-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0.15; }
  }

  @media (prefers-reduced-motion: reduce) {
    .boot { transition: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { scrambleText } from '@lib/utils/scramble';

  const MIN_BOOT = 1000; // ms — long enough to feel intentional, short enough not to annoy
  const RAIN_GLYPHS = '01アイウエオカキクケコサシスセソ$#%&@*+=<>';
  /** Module-scoped, so it survives View Transitions but resets on a real
   *  reload — which is exactly the "cold document" test we want. */
  let hasBooted = false;
  let failsafe = 0;

  function fillRainColumns(boot: HTMLElement) {
    const cols = boot.querySelectorAll<HTMLElement>('.boot__rain-col');
    cols.forEach((col) => {
      let text = '';
      for (let i = 0; i < 22; i++) {
        text += RAIN_GLYPHS[Math.floor(Math.random() * RAIN_GLYPHS.length)] + '\n';
      }
      col.textContent = text;
    });
  }

  function runBoot() {
    const boot = document.getElementById('boot');
    if (!boot) return;

    // Failsafe must NOT depend on GSAP: `hideBoot` animates via rAF, and rAF is
    // throttled (or stopped entirely) in a background tab — so a GSAP-based
    // failsafe could never fire in exactly the case it exists for, leaving the
    // overlay covering the page when the visitor returns. `forceHide` writes
    // styles directly instead.
    window.clearTimeout(failsafe);
    failsafe = window.setTimeout(forceHide, 2600);

    // Nothing to watch in a hidden tab — skip straight to the finished state so
    // the page is ready the moment it's foregrounded.
    if (document.visibilityState === 'hidden') {
      forceHide();
      return;
    }

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    boot.dataset.state = 'boot';
    boot.style.opacity = '1';
    boot.style.visibility = 'visible';

    const motif = boot.dataset.motif;
    const lines = boot.querySelectorAll('[data-line]');
    const bar = boot.querySelector<HTMLElement>('.boot__bar > i');
    const pct = boot.querySelector<HTMLElement>('[data-pct]');
    const brand = boot.querySelector<HTMLElement>('[data-brand]');
    const brandText = brand?.textContent ?? '';
    const rule = boot.querySelector<HTMLElement>('[data-rule]');
    const count = boot.querySelector<HTMLElement>('[data-count]');

    if (motif === 'rain' && !reduced) fillRainColumns(boot);

    if (reduced) {
      if (lines.length) gsap.set([...lines], { opacity: 1 });
      if (pct) pct.textContent = '100%';
      if (rule) gsap.set(rule, { scaleX: 1 });
      if (count) count.textContent = '100';
      window.setTimeout(hideBoot, 180);
      return;
    }

    const tl = gsap.timeline({
      onComplete: () => {
        if (brand) {
          scrambleText(brand, brandText, { duration: 0.45, onComplete: () => window.setTimeout(hideBoot, 150) });
        } else {
          window.setTimeout(hideBoot, 120);
        }
      },
    });
    // Every tween below is optional — a theme's loader profile can omit any of
    // them (Latte/Paper show the brand alone, plus their own motif). GSAP
    // throws on a null target, so each is added only when its element rendered.
    if (bar) {
      tl.to(
        bar,
        {
          width: '100%',
          duration: MIN_BOOT / 1000,
          ease: 'power2.out',
          onUpdate: function () {
            if (pct) pct.textContent = `${Math.round(this.progress() * 100)}%`;
          },
        },
        0
      );
    }
    if (lines.length) {
      tl.to([...lines], { opacity: 1, stagger: MIN_BOOT / 1000 / lines.length, duration: 0.08 }, 0);
    }
    if (rule) {
      tl.to(rule, { scaleX: 1, duration: MIN_BOOT / 1000, ease: 'power2.out' }, 0);
    }
    if (count) {
      const counter = { v: 0 };
      tl.to(
        counter,
        {
          v: 100,
          duration: MIN_BOOT / 1000,
          ease: 'power1.inOut',
          onUpdate: () => {
            count.textContent = String(Math.round(counter.v)).padStart(2, '0');
          },
        },
        0
      );
    }
    // With nothing else, the timeline is empty and `onComplete` fires
    // immediately — give it a beat so the brand scramble is still readable.
    if (!bar && !lines.length && !rule && !count) tl.to({}, { duration: 0.5 }, 0);
  }

  /** Hard, synchronous teardown — no animation, no rAF dependency. */
  function forceHide() {
    const boot = document.getElementById('boot');
    if (!boot || boot.dataset.state === 'done') return;
    window.clearTimeout(failsafe);
    gsap.killTweensOf(boot);
    boot.dataset.state = 'done';
    boot.style.opacity = '0';
    boot.style.display = 'none';
    document.dispatchEvent(new CustomEvent('boot:done'));
  }

  function hideBoot() {
    const boot = document.getElementById('boot');
    if (!boot || boot.dataset.state === 'done') return;
    window.clearTimeout(failsafe);
    gsap.to(boot, {
      opacity: 0,
      duration: 0.45,
      ease: 'power2.inOut',
      onComplete: () => {
        boot.dataset.state = 'done';
        boot.style.display = 'none';
        document.dispatchEvent(new CustomEvent('boot:done'));
      },
    });
    // Belt-and-braces: if the fade's rAF never completes (tab backgrounded
    // mid-fade), retire it anyway shortly after the animation's own duration.
    window.setTimeout(forceHide, 700);
  }

  /** Retire the overlay for the rest of this document's life. Called once the
   *  first boot finishes so a later navigation can never re-show it. */
  function retire() {
    const boot = document.getElementById('boot');
    if (!boot) return;
    window.clearTimeout(failsafe);
    boot.dataset.state = 'done';
    boot.style.display = 'none';
  }

  // Cold document only — see the component comment. Subsequent
  // `astro:page-load` events (client-side navigation) fall through to the
  // `retire()` branch, so the overlay never covers a redirect.
  document.addEventListener('astro:page-load', () => {
    if (hasBooted) {
      retire();
      return;
    }
    hasBooted = true;
    runBoot();
  });

  document.addEventListener('boot:done', retire, { once: true });
</script>
