---
/**
 * ProfileCard — the Broadcast theme's hero centrepiece, ported from the former
 * /v2 mini-site.
 *
 * Two-layer construction: a cream outer frame with a clipped bottom-right
 * corner, wrapping a dark inner panel whose top edge carries a diagonal notch.
 * Inside: a photo well, the surname set vertically, and a quote block with a
 * radial spark. Registration dots and a hazard-striped stat badge finish it.
 *
 * Every colour here is a semantic token (`--color-fg`, `--color-accent`, …)
 * rather than the old bespoke `--color-v2-*` names — that's what makes this a
 * theme rather than a second site bolted on.
 */
interface Props {
  name: string;
  tag: string;
  quote: string;
  statLabel: string;
  statValue: string;
  version: string;
}
const { name, tag, quote, statLabel, statValue, version } = Astro.props;

// Reuses the same portrait the cyberpunk lanyard uses, so one photo serves
// both themes instead of each shipping its own asset.
const PORTRAIT_PATH = '/lanyard/photo.jpg';
const hasPortrait = Object.keys(import.meta.glob('/public/lanyard/photo.jpg')).length > 0;
const [firstName, ...rest] = name.split(' ');
const lastName = rest.join(' ') || firstName;
---

<div class="profile-card">
  <div class="profile-card__topbar font-mono">
    <span class="profile-card__pill">{tag}</span>
    <span class="profile-card__stamp">ON<br />AIR</span>
  </div>

  <div class="profile-card__outer">
    <div class="profile-card__inner">
      <div class="profile-card__photo">
        {
          hasPortrait ? (
            <img src={PORTRAIT_PATH} alt={name} />
          ) : (
            <div class="profile-card__no-signal font-mono">NO<br />SIGNAL</div>
          )
        }
      </div>

      <span class="profile-card__name font-display">{lastName}</span>

      <div class="profile-card__quote-wrap">
        <div class="profile-card__glow" aria-hidden="true">
          <span class="profile-card__spark">✦</span>
        </div>
        <p class="profile-card__quote font-mono">{quote}</p>
        <span class="profile-card__bar" aria-hidden="true"></span>
      </div>
    </div>

    <span class="reg-dot reg-dot--1" aria-hidden="true"></span>
    <span class="reg-dot reg-dot--2" aria-hidden="true"></span>
    <span class="reg-dot reg-dot--3" aria-hidden="true"></span>
    <span class="reg-dot reg-dot--4" aria-hidden="true"></span>

    <div class="profile-card__badge font-mono">
      <span class="profile-card__badge-label">{statLabel}</span>
      <span class="profile-card__badge-value">{statValue}</span>
    </div>
  </div>

  <div class="profile-card__footer font-mono">
    <span>ZERO LATENCY PORTFOLIO</span>
    <span>V.{version}</span>
  </div>
</div>

<style>
  .profile-card {
    position: relative;
    color: var(--color-bg);
  }

  .profile-card__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.5rem 0.6rem;
  }
  .profile-card__pill {
    border: 2px solid var(--color-fg);
    border-radius: 999px;
    padding: 0.35rem 1rem;
    font-size: 0.65rem;
    letter-spacing: var(--label-tracking);
    text-transform: uppercase;
    color: var(--color-fg);
  }
  .profile-card__stamp {
    font-size: 0.6rem;
    line-height: 1.2;
    letter-spacing: 0.1em;
    text-align: right;
    color: color-mix(in srgb, var(--color-fg) 55%, transparent);
  }

  /* Outer cream frame — clipped bottom-right corner. */
  .profile-card__outer {
    position: relative;
    background: var(--color-fg);
    padding: 1.1rem;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%);
  }

  /* Inner panel — diagonal notch cut into the top edge. */
  .profile-card__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(120px, 0.9fr) auto 1.3fr;
    background: var(--color-surface);
    min-height: 320px;
    clip-path: polygon(0 0, 40% 0, 46% 22px, 58% 22px, 64% 0, 100% 0, 100% 100%, 0 100%);
  }

  .profile-card__photo {
    position: relative;
    overflow: hidden;
    background: var(--color-bg);
  }
  .profile-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    filter: contrast(1.05) saturate(1.05);
  }
  .profile-card__no-signal {
    display: flex;
    height: 100%;
    width: 100%;
    min-width: 110px;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    color: color-mix(in srgb, var(--color-fg) 35%, transparent);
    background: repeating-linear-gradient(
      45deg,
      transparent 0 8px,
      color-mix(in srgb, var(--color-fg) 4%, transparent) 8px 16px
    );
  }

  .profile-card__name {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 0.6rem;
    font-size: 1.4rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    border-left: var(--border-w) solid var(--color-fg);
    border-right: var(--border-w) solid var(--color-fg);
  }

  /* Owns glow + quote + bar as one unit so the glow tracks the quote text on
     reflow instead of the outer grid. */
  .profile-card__quote-wrap {
    position: relative;
    grid-column: 3;
    align-self: center;
    padding: 1.5rem;
  }
  .profile-card__glow {
    position: absolute;
    top: 0;
    right: 1.5rem;
    display: grid;
    height: 3.5rem;
    width: 3.5rem;
    place-items: center;
    border-radius: 999px;
    background: radial-gradient(
      circle,
      var(--color-accent) 0%,
      color-mix(in srgb, var(--color-accent) 60%, transparent) 55%,
      transparent 75%
    );
  }
  .profile-card__spark {
    font-size: 1.4rem;
    color: var(--color-fg);
  }
  .profile-card__quote {
    padding-top: 3rem;
    font-size: 0.78rem;
    line-height: 1.9;
    letter-spacing: 0.04em;
    color: var(--color-fg);
  }
  .profile-card__bar {
    display: block;
    margin-top: 1.5rem;
    height: 4px;
    background: var(--color-accent);
  }

  .reg-dot {
    position: absolute;
    height: 6px;
    width: 6px;
    background: var(--color-bg);
  }
  .reg-dot--1 {
    top: 0.5rem;
    left: 0.5rem;
  }
  .reg-dot--2 {
    top: 0.5rem;
    right: 0.5rem;
  }
  .reg-dot--3 {
    bottom: 0.5rem;
    left: 0.5rem;
  }
  .reg-dot--4 {
    bottom: 3.2rem;
    right: 3.5rem;
  }

  .profile-card__badge {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    background: repeating-linear-gradient(
      -45deg,
      var(--color-accent) 0 8px,
      var(--color-bg) 8px 16px
    );
    padding: 0.6rem 1.6rem 0.5rem 0.9rem;
    clip-path: polygon(20px 0, 100% 0, 100% 100%, 0 100%);
  }
  .profile-card__badge-label {
    font-size: 0.55rem;
    letter-spacing: var(--label-tracking);
    color: var(--color-fg);
    text-transform: uppercase;
  }
  .profile-card__badge-value {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-fg);
  }

  .profile-card__footer {
    display: flex;
    justify-content: space-between;
    padding: 0.6rem 0.5rem 0;
    font-size: 0.6rem;
    letter-spacing: var(--label-tracking);
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-fg) 40%, transparent);
  }

  /* Below 640px the 3-column split compresses past legibility — stack to
     photo / horizontal name bar / quote. The glow stays correct because it's
     positioned against the quote wrapper, not the grid. */
  @media (max-width: 640px) {
    .profile-card__inner {
      grid-template-columns: 1fr;
      grid-template-rows: 200px auto auto;
    }
    .profile-card__photo {
      grid-column: 1;
      grid-row: 1;
    }
    .profile-card__name {
      grid-column: 1;
      grid-row: 2;
      writing-mode: horizontal-tb;
      transform: none;
      border-left: none;
      border-right: none;
      border-top: var(--border-w) solid var(--color-fg);
      border-bottom: var(--border-w) solid var(--color-fg);
      padding: 0.6rem;
      text-align: center;
      font-size: 1.25rem;
    }
    .profile-card__quote-wrap {
      grid-column: 1;
      grid-row: 3;
    }
    .profile-card__glow {
      height: 2.5rem;
      width: 2.5rem;
      right: 0;
    }
    .profile-card__quote {
      padding-top: 2.75rem;
      font-size: 0.72rem;
    }
  }
</style>
