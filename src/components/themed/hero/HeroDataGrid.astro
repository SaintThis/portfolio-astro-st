---
/**
 * HeroDataGrid — the Matrix hero: a dense monospace readout.
 *
 * Structurally the opposite of the terminal hero: no giant display headline
 * and no negative space. A bordered table-like grid of labelled rows fills the
 * width, the way a system status page would, with the role rotator sitting in
 * one cell rather than dominating the page.
 */
import { SITE, AUTHOR, HERO, ROTATOR_MAX_CH } from '@/config';
import Button from '@components/ui/Button.astro';

const rows = [
  { k: 'operator', v: SITE.name },
  { k: 'role', v: SITE.role },
  { k: 'location', v: SITE.location },
  { k: 'status', v: AUTHOR.availableForWork ? 'OPEN TO WORK' : 'HEADS-DOWN' },
];

/**
 * The document's top-level heading, joined here rather than interpolated as
 * three adjacent expressions in the template: Astro strips the whitespace
 * between an expression and its neighbour, which ran this together as
 * "Buildingfullstack systemsthat ship & scale." (the same bite recorded in
 * HeroBroadcast, which solved it with an explicit gap instead).
 *
 * This variant renders no display headline on purpose — a readout doesn't have
 * one — and was the only hero shipping a homepage with no top-level heading at
 * all. A visually-hidden heading gives assistive tech and crawlers the same
 * words the other four show visibly, keeping all five in content parity,
 * without putting a banner back on a layout designed to refuse one.
 */
const heading = [HERO.headline.lead, HERO.rotatorWords[0], HERO.headline.trail].join(' ');
---

<section class="py-12" data-hero-variant="datagrid">
  <h1 class="sr-only">{heading}</h1>

  <div class="border-border border" data-reveal>
    <!-- Readout header -->
    <div class="border-border flex items-center justify-between border-b px-4 py-2">
      <span class="text-accent font-mono text-[11px] tracking-[0.25em] uppercase">
        ./{SITE.handle.replace('@', '')} —— session
      </span>
      <span class="text-fg-faint font-mono text-[11px]">
        {new Date().getFullYear()}
      </span>
    </div>

    <!-- Labelled rows -->
    <dl class="divide-border divide-y">
      {
        rows.map((r) => (
          <div class="grid grid-cols-[7rem_1fr] gap-4 px-4 py-2.5 sm:grid-cols-[10rem_1fr]">
            <dt class="text-fg-faint font-mono text-[11px] tracking-[0.2em] uppercase">{r.k}</dt>
            <dd class="text-fg font-mono text-sm">{r.v}</dd>
          </div>
        ))
      }
      <div class="grid grid-cols-[7rem_1fr] gap-4 px-4 py-2.5 sm:grid-cols-[10rem_1fr]">
        <dt class="text-fg-faint font-mono text-[11px] tracking-[0.2em] uppercase">building</dt>
        <dd>
          <span
            class="text-accent text-glow inline-block font-mono text-sm whitespace-nowrap"
            id="hero-role"
            style={`min-width: ${ROTATOR_MAX_CH}ch`}>{HERO.rotatorWords[0]}</span
          >
        </dd>
      </div>
      <div class="grid grid-cols-[7rem_1fr] gap-4 px-4 py-2.5 sm:grid-cols-[10rem_1fr]">
        <dt class="text-fg-faint font-mono text-[11px] tracking-[0.2em] uppercase">stack</dt>
        <dd class="text-fg-muted font-mono text-sm">{HERO.stack.join(' · ')}</dd>
      </div>
    </dl>

    <!-- Payload -->
    <div class="border-border border-t px-4 py-4">
      <p class="text-fg-muted max-w-3xl font-mono text-sm leading-relaxed">
        <span class="text-accent">&gt;</span>
        {HERO.intro}
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        {
          HERO.actions.map((a) => (
            <Button href={a.href} variant={a.variant} size="sm" download={a.download}>
              {a.label} {a.icon && <span aria-hidden="true">{a.icon}</span>}
            </Button>
          ))
        }
      </div>
    </div>
  </div>
</section>
