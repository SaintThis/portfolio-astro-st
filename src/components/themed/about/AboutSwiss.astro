---
/**
 * AboutSwiss — the Paper intro: an International-Style grid.
 *
 * Mirrors `HeroSwiss`: a visible 12-column grid, a numbered index of facts in
 * the narrow columns, body copy offset into the grid for the classic asymmetry,
 * and hairline rules doing all the separating. No ornament, no glow.
 */
import { ABOUT } from '@/config';
import AboutBody from './AboutBody.astro';
---

<div class="mt-10 grid gap-x-6 gap-y-12 lg:grid-cols-12">
  <!-- Numbered index: 4 of 12 -->
  <div class="lg:col-span-4" data-reveal>
    <dl class="space-y-0">
      {
        ABOUT.profile.map((r, i) => (
          <div class="border-border grid grid-cols-[2rem_1fr] gap-3 border-t py-3">
            <dt class="text-fg-faint font-mono text-[10px]">{String(i + 1).padStart(2, '0')}</dt>
            <dd>
              <span class="text-fg-faint block font-mono text-[10px] tracking-[0.2em] uppercase">
                {r.k}
              </span>
              <span class="mt-0.5 block text-sm">{r.v}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>

  <!-- Body: 7 of 12, offset one column off the index -->
  <div class="lg:col-span-7 lg:col-start-6" data-reveal data-delay="0.12">
    <p class="text-fg-muted max-w-prose text-lg leading-relaxed">{ABOUT.lead}</p>
    <AboutBody class="text-fg-muted mt-5 max-w-prose text-lg leading-relaxed" />
  </div>

  <!-- Traits: a second numbered index, back on the left edge -->
  <div class="lg:col-span-8 lg:col-start-1" data-reveal data-delay="0.18">
    <span class="text-fg-faint font-mono text-[10px] tracking-[0.2em] uppercase">Also</span>
    <ul class="mt-3 grid gap-x-6 sm:grid-cols-2">
      {
        ABOUT.traits.map((t, i) => (
          <li class="border-border flex items-baseline gap-3 border-b py-2">
            <span class="text-fg-faint font-mono text-[10px]">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="text-sm">{t}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
