---
/**
 * ProjectCard — a dispatcher, not a component.
 *
 * Keeps its original `project: Project` prop and its original path, so every
 * call site (`FeaturedWork`, `projects/index`, the "More work" rail) is
 * untouched by the variant system.
 *
 * Only two card structures exist on purpose: the standard card (themed by
 * tokens) and Broadcast's clipped panel. Cyberpunk/matrix/latte/paper differ
 * in border weight, radius, glow, type and label case — all token work, none
 * of which justifies its own file or the CSS every extra import would ship to
 * every page.
 */
import type { Project } from '@lib/api/types';
import { getThemeLayout } from '@/config';
import CardStandard from '@components/themed/card/CardStandard.astro';
import CardPanel from '@components/themed/card/CardPanel.astro';

interface Props {
  project: Project;
  /** Index in a grid — Broadcast rotates which corner each panel cuts. */
  index?: number;
}
const { project, index = 0 } = Astro.props;

const layout = getThemeLayout(Astro.locals?.theme);
const CORNERS = ['tr', 'tl', 'br', 'bl'] as const;
// The bracket flourish suits the technical themes; an editorial/print card
// wants a clean corner.
const bracket = layout.hero === 'terminal' || layout.hero === 'datagrid';
---

{
  layout.card === 'panel' ? (
    <CardPanel project={project} corner={CORNERS[index % CORNERS.length]} />
  ) : (
    <CardStandard project={project} bracket={bracket} />
  )
}
