---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Button from '@components/ui/Button.astro';
import AboutIntro from '@components/sections/AboutIntro.astro';
import AboutSkills from '@components/sections/AboutSkills.astro';
import AboutExperience from '@components/sections/AboutExperience.astro';
import { getSkills, getExperience } from '@lib/api';
import { AUTHOR, ABOUT } from '@/config';

// On-demand rendered: experience is DB-backed now, so this reads live from
// Postgres at request time — admin/MCP edits show up with no rebuild, matching
// the blog/projects pages. Skills stays a cheap local-fixture read either way.
//
// It ALSO has to stay on-demand for the theme: middleware never runs on a
// prerendered route, so a static /about could only ever emit the default
// theme's markup, and the three dispatchers below would all pick the wrong
// variant.
export const prerender = false;

const skills = await getSkills();
const experience = await getExperience();

// The page is now a shell: headings + data, with each section's STRUCTURE
// chosen per theme (see the dispatchers). Copy lives in `ABOUT` so all five
// intro variants render identical words — a crawler sees the default variant
// while a returning visitor may see another, so the text has to match.
const { intro, skills: skillsMeta, experience: expMeta } = ABOUT.sections;
---

<BaseLayout title="About" description={AUTHOR.summary}>
  <!-- Intro — 5 variants -->
  <section class="py-16">
    <!-- `as="h1"`: this page is built entirely from sections, so without it
         /about shipped three h2s and no h1 in every theme. -->
    <SectionHeading kicker={intro.kicker} title={intro.title} index={intro.index} as="h1" />
    <AboutIntro />
  </section>

  <!-- Skills — 3 variants -->
  <section class="py-16">
    <SectionHeading kicker={skillsMeta.kicker} title={skillsMeta.title} index={skillsMeta.index} />
    <AboutSkills skills={skills} />
  </section>

  <!-- Experience — 3 variants -->
  <section class="py-16">
    <SectionHeading kicker={expMeta.kicker} title={expMeta.title} index={expMeta.index} />
    <AboutExperience experience={experience} />

    <div class="mt-12 text-center">
      <Button href={ABOUT.cta.href} variant="outline">
        {ABOUT.cta.label}
        <span aria-hidden="true">→</span>
      </Button>
    </div>
  </section>
</BaseLayout>
