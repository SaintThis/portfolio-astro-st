---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import ProjectCard from '@components/ui/ProjectCard.astro';
import Reveal from '@components/ui/Reveal.astro';
import { PROJECTS } from '@/config';
import { getProjects } from '@lib/api';

// On-demand rendered: reads live from the DB at request time so MCP/admin edits
// appear without a rebuild. Falls back to fixtures when DATABASE_URL is unset.
// Category filter + pagination are driven by ?category= and ?page= query params
// (server-side, zero client JS) — same pattern as the blog index. The previous
// client-side filter depended on a data attribute that `Reveal` dropped, so it
// hid every card instead of filtering; rendering the filter on the server makes
// that class of bug impossible and gives shareable, crawlable filter URLs.
export const prerender = false;

const all = await getProjects();

// Category chips: only categories that actually have projects, with counts.
const counts = new Map<string, number>();
for (const p of all) counts.set(p.category, (counts.get(p.category) ?? 0) + 1);
const categories = [...counts.keys()].sort((a, b) => a.localeCompare(b));

const params = Astro.url.searchParams;
const requested = params.get('category');
// Ignore an unknown ?category= rather than rendering an empty grid.
const activeCategory = requested && counts.has(requested) ? requested : null;
const filtered = activeCategory ? all.filter((p) => p.category === activeCategory) : all;

const pageSize = PROJECTS.pageSize;
const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
const page = Math.min(totalPages, Math.max(1, Number(params.get('page')) || 1));
const projects = filtered.slice((page - 1) * pageSize, page * pageSize);

/** Build a query string preserving category while changing page (and vice versa). */
const hrefFor = (opts: { category?: string | null; page?: number }) => {
  const sp = new URLSearchParams();
  const cat = opts.category === undefined ? activeCategory : opts.category;
  if (cat) sp.set('category', cat);
  if (opts.page && opts.page > 1) sp.set('page', String(opts.page));
  const qs = sp.toString();
  return qs ? `/projects?${qs}` : '/projects';
};

const pageTitle = activeCategory
  ? `Projects — ${activeCategory}${page > 1 ? ` (page ${page})` : ''}`
  : `Projects${page > 1 ? ` (page ${page})` : ''}`;
const pageDescription = activeCategory
  ? `${counts.get(activeCategory)} ${activeCategory} projects — architecture, implementation, and what shipped.`
  : 'A selection of fullstack projects — Flutter UI kits, marketplaces, microfrontends, backend services, and tooling.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="py-16">
    <SectionHeading kicker="portfolio" title="Projects" index="//" />
    <p class="mt-4 max-w-xl text-fg-muted">
      Things I've architected, built, and shipped — each one with the stack, the constraints, and
      the decisions behind it. Filter by category below.
    </p>

    <!-- Server-rendered filter: real links, so it works without JS and each
         filtered view is its own shareable, indexable URL. -->
    {
      categories.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-2" aria-label="Filter projects by category">
          <a
            href={hrefFor({ category: null, page: 1 })}
            class:list={['cat-chip', !activeCategory && 'is-active']}
            aria-current={!activeCategory ? 'page' : undefined}
            data-cursor="hover"
          >
            all <span class="cat-chip__count">{all.length}</span>
          </a>
          {categories.map((c) => (
            <a
              href={hrefFor({ category: c, page: 1 })}
              class:list={['cat-chip', activeCategory === c && 'is-active']}
              aria-current={activeCategory === c ? 'page' : undefined}
              data-cursor="hover"
            >
              {c} <span class="cat-chip__count">{counts.get(c)}</span>
            </a>
          ))}
        </div>
      )
    }

    <p class="mt-6 font-mono text-xs text-fg-faint">
      {filtered.length}
      {filtered.length === 1 ? 'project' : 'projects'}
      {activeCategory && <> in <span class="text-accent-2">{activeCategory}</span></>}
    </p>

    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((p, i) => (
          <Reveal delay={(i % 3) * 0.06} class="h-full" data-category={p.category}>
            <ProjectCard project={p} index={i} />
          </Reveal>
        ))
      }
    </div>

    {
      filtered.length === 0 && (
        <p class="mt-10 font-mono text-fg-faint">// nothing here yet — check back soon™</p>
      )
    }

    {
      totalPages > 1 && (
        <nav
          class="mt-12 flex items-center justify-between font-mono text-sm"
          aria-label="Pagination"
        >
          {page > 1 ? (
            <a href={hrefFor({ page: page - 1 })} class="page-link" data-cursor="hover" rel="prev">
              ← newer
            </a>
          ) : (
            <span class="page-link is-disabled">← newer</span>
          )}
          <span class="text-fg-faint">
            page {page} / {totalPages}
          </span>
          {page < totalPages ? (
            <a href={hrefFor({ page: page + 1 })} class="page-link" data-cursor="hover" rel="next">
              older →
            </a>
          ) : (
            <span class="page-link is-disabled">older →</span>
          )}
        </nav>
      )
    }
  </section>
</BaseLayout>

<style>
  .cat-chip {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-box);
    color: var(--color-fg-muted);
    transition:
      color 0.2s var(--ease-out-expo),
      border-color 0.2s var(--ease-out-expo);
  }
  .cat-chip:hover {
    color: var(--color-fg);
    border-color: var(--color-accent);
  }
  .cat-chip.is-active {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border-color: var(--color-accent);
  }
  .cat-chip__count {
    opacity: 0.6;
    font-size: 0.7rem;
  }
  .page-link {
    color: var(--color-fg-muted);
    transition: color 0.2s var(--ease-out-expo);
  }
  .page-link:hover {
    color: var(--color-accent);
  }
  .page-link.is-disabled {
    opacity: 0.35;
  }
</style>
