---
import BaseLayout from '@layouts/BaseLayout.astro';
import Tag from '@components/ui/Tag.astro';
import Button from '@components/ui/Button.astro';
import ViewTracker from '@components/blog/ViewTracker.astro';
import { PROJECTS } from '@/config';
import { getProject, getProjects } from '@lib/api';
import { formatDate, isoDate } from '@lib/utils';

// On-demand rendered: one Worker request per project, read live from the DB.
export const prerender = false;

const { slug } = Astro.params;
const project = await getProject(slug!);
if (!project) return Astro.redirect('/404');

// The description is authored as plain text with blank-line paragraph breaks.
// Rendering it as a single <p> collapsed all of them into one wall of text, so
// split here and render real paragraphs. A leading "## " marks a section head.
const blocks = project.description
  .split(/\n{2,}/)
  .map((b) => b.trim())
  .filter(Boolean);

// "More work" rail — same category first, then anything else, never itself.
const others = (await getProjects()).filter((p) => p.slug !== project.slug);
const related = [
  ...others.filter((p) => p.category === project.category),
  ...others.filter((p) => p.category !== project.category),
].slice(0, 3);

const statusMap = {
  live: { label: 'LIVE', color: 'text-success' },
  wip: { label: 'WIP', color: 'text-warning' },
  archived: { label: 'ARCHIVED', color: 'text-fg-faint' },
} as const;
const status = statusMap[project.status];
---

<BaseLayout
  title={project.title}
  description={project.summary}
  type="project"
  image={project.cover}
  publishedTime={isoDate(project.date)}
  tags={project.tags}
  projectMeta={{
    stack: project.tags,
    repo: project.links.repo,
    live: project.links.live,
    breadcrumb: [
      { name: 'Home', item: '/' },
      { name: 'Projects', item: '/projects' },
      { name: project.title, item: `/projects/${project.slug}` },
    ],
  }}
>
  {PROJECTS.viewCounts && <ViewTracker slug={project.slug} endpoint="/api/project-views" />}

  <article class="py-16">
    <a href="/projects" class="font-mono text-sm text-fg-muted hover:text-accent" data-cursor="hover"
      >← all projects</a
    >

    <header class="mt-6">
      <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-fg-faint">
        <a
          href={`/projects?category=${project.category}`}
          class="text-accent-2 hover:underline"
          data-cursor="hover">{project.category.toUpperCase()}</a
        >
        <span>·</span>
        <time datetime={isoDate(project.date)}>{formatDate(project.date)}</time>
        <span>·</span>
        <span class:list={[status.color]}>● {status.label}</span>
        {
          PROJECTS.viewCounts && (
            <>
              <span>·</span>
              <span>
                <span data-view-count>{(project.views ?? 0).toLocaleString()}</span> views
              </span>
            </>
          )
        }
      </div>
      <h1 class="mt-4 text-4xl font-extrabold sm:text-6xl text-gradient">{project.title}</h1>
      <p class="mt-4 max-w-2xl text-lg text-fg-muted">{project.summary}</p>
    </header>

    {
      project.cover && (
        <img
          src={project.cover}
          alt={`${project.title} — cover`}
          class="mt-8 w-full rounded-[var(--radius-box)] border border-border"
          loading="eager"
          decoding="async"
        />
      )
    }

    {
      project.metrics && (
        <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
          {project.metrics.map((m) => (
            <div class="rounded-[var(--radius-box)] border border-border bg-surface p-4">
              <div class="font-mono text-2xl font-bold text-accent-2">{m.value}</div>
              <div class="text-xs text-fg-muted">{m.label}</div>
            </div>
          ))}
        </div>
      )
    }

    <!-- The case study itself. Paragraph blocks, with "## " lines promoted to
         section headings so a long description reads as a real write-up. -->
    <div class="project-body mt-12 max-w-2xl">
      {
        blocks.map((b) =>
          b.startsWith('## ') ? (
            <h2 class="mt-10 text-xl font-bold text-fg sm:text-2xl">{b.slice(3)}</h2>
          ) : b.startsWith('- ') ? (
            <ul class="mt-4 space-y-2">
              {b.split('\n').map((li) => (
                <li class="flex gap-3 text-fg-muted">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent" />
                  <span>{li.replace(/^-\s*/, '')}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-4 leading-relaxed text-fg-muted">{b}</p>
          )
        )
      }
    </div>

    <div class="mt-10">
      <h2 class="kicker">Stack</h2>
      <div class="mt-3 flex flex-wrap gap-1.5">
        {project.tags.map((t) => <Tag accent>{t}</Tag>)}
      </div>
    </div>

    {
      (project.links.live || project.links.repo) && (
        <div class="mt-10 flex flex-wrap gap-3">
          {project.links.live && <Button href={project.links.live}>Visit live →</Button>}
          {project.links.repo && (
            <Button href={project.links.repo} variant="outline">
              Source
            </Button>
          )}
        </div>
      )
    }

    {
      project.screenshots && project.screenshots.length > 0 && (
        <div class="mt-16">
          <h2 class="kicker">Screenshots</h2>
          <div class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-2">
            {project.screenshots.map((src, i) => (
              <img
                src={src}
                alt={`${project.title} — screenshot ${i + 1}`}
                class="w-full rounded-[var(--radius-box)] border border-border"
                loading="lazy"
                decoding="async"
              />
            ))}
          </div>
        </div>
      )
    }

    {
      related.length > 0 && (
        <nav class="mt-20 border-t border-border pt-8" aria-label="More projects">
          <h2 class="kicker">More work</h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-3">
            {related.map((p) => (
              <li>
                <a
                  href={`/projects/${p.slug}`}
                  class="group block h-full rounded-[var(--radius-box)] border border-border bg-surface p-4 transition-colors hover:border-accent/60"
                  data-cursor="hover"
                  data-cursor-label="View"
                >
                  <span class="font-mono text-[11px] tracking-widest text-fg-faint">
                    {p.category.toUpperCase()}
                  </span>
                  <div class="mt-1 font-bold transition-colors group-hover:text-accent">
                    {p.title}
                  </div>
                  <p class="mt-1 line-clamp-2 text-sm text-fg-muted">{p.summary}</p>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </article>
</BaseLayout>
